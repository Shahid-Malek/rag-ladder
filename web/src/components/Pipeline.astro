---
import Section from './Section.astro';
import { Code2, Library, Cloud } from 'lucide-react';
import Groq from '@/assets/logos/groq.svg';
import OpenRouter from '@/assets/logos/openrouter.svg';
import Qdrant from '@/assets/logos/qdrant.svg';
import NumPy from '@/assets/logos/numpy.svg';
import Python from '@/assets/logos/python.svg';
import LlamaIndex from '@/assets/logos/llamaindex.svg';
import Postgres from '@/assets/logos/postgresql.svg';
import LangGraph from '@/assets/logos/langgraph.svg';
const logos = {
  groq: Groq,
  openrouter: OpenRouter,
  qdrant: Qdrant,
  numpy: NumPy,
  python: Python,
  llamaindex: LlamaIndex,
  postgresql: Postgres,
  langgraph: LangGraph,
};
import AnimatedButton from './AnimatedButton.astro';
import type { LevelInfo } from '@/data/levels';
const { info } = Astro.props as { info: LevelInfo };
---

<Section eyebrow="FROM NOTES TO EVIDENCE" class="pipeline-section">
  <div class="pipeline-layout" data-pipeline>
    <aside class="flow-column">
      <nav class="flow-nodes" aria-label={`${info.name} pipeline stages`}>
        {info.stages.map((stage, index) => (
          <div class="flow-step">
            <AnimatedButton
              class="flow-node"
              href={`#${info.slug}-stage-${stage.id}`}
              data-flow-target={`${info.slug}-stage-${stage.id}`}
              aria-controls={`${info.slug}-stage-${stage.id}`}
              aria-current={index === 0 ? 'step' : undefined}
            >
              <span class="node-number">{index + 1}</span>
              {stage.name}
            </AnimatedButton>
            {index < info.stages.length - 1 && (
              <svg
                class="flow-connector"
                viewBox="0 0 20 24"
                aria-hidden="true"
              >
                <path d="M10 3v17m-4-4 4 4 4-4" />
              </svg>
            )}
          </div>
        ))}
      </nav>
      <p class="text-body text-muted-foreground mt-4">
        Select a step to jump to its card.
      </p>
      <p class="text-body mt-3" data-stage-progress aria-live="polite">
        1 of {info.stages.length}
      </p>
      {info.id === 'l3' && (
        <p class="text-body mt-3">Advanced uses the private local path.</p>
      )}
    </aside>
    <div class="pipeline-stages">
      {info.stages.map((stage, index) => (
        <article
          class="panel pipeline-card"
          id={`${info.slug}-stage-${stage.id}`}
          data-stage
          tabindex="0"
          aria-label={`${info.name}: stage ${index + 1} of ${info.stages.length}`}
        >
          <div>
            <p class="eyebrow">
              {info.name.toUpperCase()} / STAGE {index + 1} OF{' '}
              {info.stages.length}
            </p>
            <h2 class="mt-4 text-3xl">{stage.name}</h2>
            <p class="mt-4">{stage.detail}</p>
            <h3 class="mt-5 text-product-label">Why this stage exists</h3>
            <p class="mt-3 text-muted-foreground">{stage.why}</p>
          </div>
          <div class="stage-tech">
            <h3 class="text-product-label">How it works</h3>
            <p class="mt-3 mb-5 text-body text-muted-foreground">{stage.how}</p>
            <h3 class="text-product-label">Tech used in this stage</h3>
            <div class="stage-tech-grid">
              {stage.tech.map((tech) => {
                const Logo = tech.logo ? logos[tech.logo] : undefined;
                const Icon =
                  tech.kind === 'custom code'
                    ? Code2
                    : tech.kind === 'service'
                      ? Cloud
                      : Library;
                return (
                  <div class="stage-tech-tile" data-stage-tech>
                    <div class="stage-tech-title">
                      {Logo ? (
                        <Logo
                          fill="currentColor"
                          width={22}
                          height={22}
                          aria-hidden="true"
                        />
                      ) : (
                        <Icon size={22} aria-hidden="true" />
                      )}
                      <h4>{tech.name}</h4>
                    </div>
                    <p>{tech.role}</p>
                    <small>{tech.kind}</small>
                  </div>
                );
              })}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Section>
<Section eyebrow="KNOWN LIMITS">
  <div class="panel">
    <h2 class="text-3xl">Known limits</h2>
    <ul class="mt-6 list-disc space-y-4 pl-5">
      {info.limits.map((limit) => (
        <li>{limit}</li>
      ))}
    </ul>
    <p class="mt-6">
      These results describe frozen retrieval with processing off.
    </p>
  </div>
</Section>
