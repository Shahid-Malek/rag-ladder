---
import GithubLogo from '@/assets/logos/github.svg';
import { Skeleton } from '@/components/ui/skeleton';
import { site } from '@/data/site';
import { getBuildStarCount } from '@/lib/github';
const fallback = await getBuildStarCount();
---

<a
  href={site.repository}
  target="_blank"
  rel="noopener noreferrer"
  class="github-stars pill pill-primary"
  aria-label="Star RAG-Ladder on GitHub (opens in a new tab)"
>
  <GithubLogo width={18} height={18} aria-hidden="true" />
  <span>Star</span>
  <span data-stars data-fallback={fallback} class="star-count" aria-busy="true">
    <span
      data-stars-skeleton
      role="status"
      aria-label="Loading GitHub star count"
    >
      <Skeleton className="h-4 w-9 rounded-pill" />
    </span>
    <span data-stars-value hidden></span>
    {site.repositoryPrivate && (
      <span class="sr-only">
        Star count not available for this private repository
      </span>
    )}
    <noscript>
      {fallback === null ? '' : fallback.toLocaleString('en')}
    </noscript>
  </span>
</a>
<style>
  .github-stars {
    gap: 9px;
    padding: 10px 17px;
    white-space: nowrap;
  }
  .star-count {
    width: 5ch;
    min-height: 18px;
    display: grid;
    place-items: center;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }
  .star-count > * {
    grid-area: 1/1;
  }
</style>
<script>
  import { site } from '@/data/site';
  const key = 'rag-ladder:github-stars:v1';
  let pending: Promise<number | null> | undefined;
  async function count(): Promise<number | null> {
    if (site.repositoryPrivate) return null;
    try {
      const cached = JSON.parse(localStorage.getItem(key) || 'null');
      if (
        cached &&
        Number.isSafeInteger(cached.count) &&
        cached.count >= 0 &&
        Number.isFinite(cached.at) &&
        Date.now() >= cached.at &&
        Date.now() - cached.at < 3600000
      )
        return cached.count;
    } catch {
      /* Storage is optional; continue without the cache. */
    }
    try {
      const response = await fetch(site.repositoryApi, {
        signal: AbortSignal.timeout(6000),
        headers: { Accept: 'application/vnd.github+json' },
      });
      if (!response.ok) return null;
      const data = await response.json();
      if (
        !Number.isSafeInteger(data.stargazers_count) ||
        data.stargazers_count < 0
      )
        return null;
      try {
        localStorage.setItem(
          key,
          JSON.stringify({ count: data.stargazers_count, at: Date.now() }),
        );
      } catch {
        /* Private browsing may deny storage. */
      }
      return data.stargazers_count;
    } catch {
      return null;
    }
  }
  async function initializeStars() {
    const request = (pending ??= count());
    const countValue = await request;
    if (pending === request) pending = undefined;
    document
      .querySelectorAll<HTMLElement>('[data-stars]')
      .forEach((element) => {
        element.querySelector('[data-stars-skeleton]')?.remove();
        const value = element.querySelector<HTMLElement>('[data-stars-value]');
        if (value) {
          value.textContent =
            countValue === null ? '—' : countValue.toLocaleString('en');
          value.hidden = false;
          if (countValue === null) value.setAttribute('aria-hidden', 'true');
          value.title =
            countValue === null
              ? 'GitHub star count not available'
              : 'GitHub stars';
        }
        element.setAttribute('aria-busy', 'false');
      });
  }
  document.addEventListener('astro:page-load', initializeStars);
</script>
