---
import { site } from '@/data/site';
import { withBase } from '@/lib/paths';
import GitHubStars from './GitHubStars.astro';
import SlidingToggle from './SlidingToggle.astro';
const current = Astro.url.pathname;
const links = [
  { href: '/', text: 'Overview' },
  { href: '/compare/', text: 'Compare' },
  { href: '/pipeline/', text: 'Pipeline' },
  { href: '/results/', text: 'Results' },
  { href: '/naive/', text: 'Naive' },
  { href: '/intermediate/', text: 'Intermediate' },
  { href: '/advanced/', text: 'Advanced' },
];
---

<header
  class="site-header"
  transition:persist="site-header"
  transition:animate="none"
>
  <nav class="main-nav container" aria-label="Main navigation">
    <a
      class="wordmark animated-button"
      href={withBase('/')}
      aria-label={`${site.name} home`}
    >
      <svg
        width="18"
        height="26"
        viewBox="0 0 21 26"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M3 2v22M18 2v22M3 6h15M3 13h15M3 20h15"
          stroke="currentColor"
          stroke-width="2"
        />
      </svg>
      <span>RAG—Ladder</span>
    </a>
    <div class="desktop-links">
      <SlidingToggle label="Explore RAG-Ladder" class="header-toggle">
        {links.map((link, i) => (
          <a
            data-option
            data-astro-prefetch="hover"
            class:list={['animated-button', { 'nav-divider': i === 4 }]}
            href={withBase(link.href)}
            aria-current={current === withBase(link.href) ? 'page' : undefined}
          >
            {link.text}
            {i === 6 && <small class="local-tag">Local only</small>}
          </a>
        ))}
      </SlidingToggle>
    </div>
    <div class="nav-actions">
      <GitHubStars />
    </div>
    <details class="mobile-menu">
      <summary aria-label="Open navigation">
        <span></span>
        <span></span>
      </summary>
      <SlidingToggle label="Explore RAG-Ladder" class="mobile-links">
        {links.map((link, i) => (
          <a
            data-option
            data-astro-prefetch="hover"
            href={withBase(link.href)}
            aria-current={current === withBase(link.href) ? 'page' : undefined}
          >
            {link.text}
            {i === 6 && <small class="local-tag">Local only</small>}
          </a>
        ))}
      </SlidingToggle>
    </details>
  </nav>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    padding-block: 14px;
  }
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 -28px;
    background: linear-gradient(var(--color-background) 40%, transparent);
    pointer-events: none;
    z-index: -1;
  }
  .main-nav {
    --pad: 8px;
    --r-inner: 15px;
    min-height: 68px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    padding: var(--pad) 16px;
    border: 1px solid var(--color-border);
    border-radius: calc(var(--r-inner) + var(--pad));
    background: var(--color-panel);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 17px;
    font-weight: 600;
    text-decoration: none;
    width: max-content;
    min-height: 44px;
  }
  .wordmark svg {
    color: var(--color-primary);
  }
  .nav-actions {
    justify-self: end;
  }
  .header-toggle {
    background: transparent;
    font-size: 12px;
  }
  .header-toggle :global([data-option]) {
    padding: 8px 9px;
    gap: 5px;
  }
  .header-toggle :global(.nav-divider) {
    margin-left: 8px;
  }
  .mobile-menu {
    display: none;
  }
  .mobile-menu summary {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    list-style: none;
  }
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .mobile-menu summary span {
    height: 1px;
    width: 18px;
    background: currentColor;
  }
  .mobile-menu :global(.mobile-links) {
    position: absolute;
    left: 16px;
    right: 16px;
    top: calc(100% - 8px);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    padding: 8px;
    border: 1px solid var(--color-border);
    background: var(--color-panel);
  }
  @media (max-width: 1100px) {
    .wordmark {
      font-size: 14px;
      gap: 5px;
    }
    .header-toggle :global([data-option]) {
      padding-inline: 7px;
    }
    .main-nav {
      padding-inline: 10px;
      gap: 6px;
    }
  }
  @media (max-width: 1279px) {
    .main-nav {
      grid-template-columns: 1fr auto auto;
      padding: 8px 12px;
    }
    .desktop-links {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    .wordmark {
      font-size: 16px;
    }
    .site-header {
      padding-block: 10px;
    }
  }
</style>
