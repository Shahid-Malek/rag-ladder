---
import Section from '@/components/Section.astro';
import Layout from '@/layouts/Layout.astro';
import TechLogos from '@/components/TechLogos.astro';
import LevelSection from '@/components/LevelSection.astro';
import ProductStage from '@/components/ProductStage';
import HeroSwarm from '@/components/HeroSwarm';
import AnimatedButton from '@/components/AnimatedButton.astro';
import Stats2 from '@/components/ui/stats-2';
import GitHubStars from '@/components/GitHubStars.astro';
import { levelStats, evaluationNote } from '@/data/evaluation';
import { withBase } from '@/lib/paths';
---

<Layout
  title="Same notes. Three ways to answer."
  description="Compare Naive, Intermediate and Advanced retrieval with student notes and inspect the saved evidence."
>
  <Section
    eyebrow="A STUDENT-NOTES RAG DEMO"
    hero
    contained={false}
    class="stage hero"
    id="hero"
  >
    <HeroSwarm client:media="(hover:hover) and (pointer:fine) and (prefers-reduced-motion:no-preference)" />
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 class="text-display-xl" tabindex="0" data-headline-pause>
          <span class="sr-only">Same notes. Three ways to answer.</span>
          <span aria-hidden="true">
            Same notes.
            <br />
            <span class="hero-accent rotating-headline" data-headline>
              Three ways
            </span>
            <br />
            to answer.
          </span>
        </h1>
        <p class="hero-description">
          Start with a simple retrieval pipeline. Add hybrid search. Then
          explore reranking and richer context. See what changes—and what the
          evidence supports.
        </p>
        <div class="hero-actions">
          {levelStats.map((stat) => (
            <AnimatedButton
              href={withBase(`/${stat.name.toLowerCase()}/`)}
              class={
                stat.level === 'L1'
                  ? 'pill pill-primary'
                  : 'pill pill-secondary'
              }
            >
              {stat.name}
              {stat.level === 'L3' && (
                <small class="local-tag">Local only</small>
              )}
            </AnimatedButton>
          ))}
          <AnimatedButton
            href={withBase('/results/')}
            class="pill pill-secondary"
          >
            See the results
          </AnimatedButton>
        </div>
        <p class="text-utility-nav text-muted-foreground mt-4">
          Advanced can only be run locally.
        </p>
        <div class="hero-repo">
          <GitHubStars />
          <span>
            Read the code.
            <br />
            Follow the evidence.
          </span>
        </div>
      </div>
      <div>
        <ProductStage stats={levelStats} />
      </div>
    </div>
    <div class="container hero-bottom">
      <span>RETRIEVAL-AUGMENTED GENERATION, STEP BY STEP</span>
      <a href="#levels">
        Explore the ladder <span aria-hidden="true">↓</span>
      </a>
    </div>
  </Section>
  <Section eyebrow="THE LADDER" class="levels" id="levels" data-spy="levels">
    <div class="section-heading">
      <div>
        <h2 class="text-display">
          Each level adds
          <br />a different idea.
        </h2>
      </div>
      <p>Inspect the approach before deciding which complexity is useful.</p>
    </div>
    <Stats2 stats={levelStats} />
    <p class="evaluation-note">{evaluationNote}</p>
    <AnimatedButton href={withBase('/compare/')} class="pill pill-secondary">
      Compare the approaches <span aria-hidden="true">↗</span>
    </AnimatedButton>
  </Section>
  <TechLogos />
  <LevelSection />
  <Section
    eyebrow="YOUR NOTES, YOUR QUESTIONS"
    class="checkpoint"
    id="closing"
    data-spy="evidence"
  >
    <div class="checkpoint-inner">
      <div>
        <h2>
          Start small.
          <br />
          Inspect what changes.
        </h2>
      </div>
      <div>
        <p>Try Naive or Intermediate, or inspect Advanced’s local workflow.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          {levelStats.map((stat) => (
            <AnimatedButton
              href={withBase(`/${stat.name.toLowerCase()}/`)}
              class={
                stat.level === 'L1'
                  ? 'pill pill-primary'
                  : 'pill pill-secondary'
              }
            >
              {stat.name}
              {stat.level === 'L3' && (
                <small class="local-tag">Local only</small>
              )}
            </AnimatedButton>
          ))}
        </div>
      </div>
    </div>
  </Section>
</Layout>
<style>
  .hero {
    padding-top: 58px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.02fr;
    gap: 64px;
    padding-bottom: 72px;
    align-items: start;
  }
  .hero-copy {
    padding-top: 28px;
  }
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 32px;
    color: var(--color-foreground);
    opacity: 0.7;
  }
  .hero-rule {
    display: block;
    width: 28px;
    height: 1px;
    background: var(--color-primary);
  }
  h1 {
    color: var(--color-foreground);
  }
  .hero-accent {
    color: var(--color-primary);
  }
  .hero-description {
    max-width: 420px;
    margin-top: 32px;
    color: var(--color-muted-foreground);
    font-size: 17px;
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 32px;
  }
  .hero-actions .pill {
    min-height: 48px;
  }
  .hero-repo {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 32px;
  }
  .hero-repo :global(.github-stars) {
    background: var(--color-secondary);
    color: var(--color-foreground);
  }
  .hero-repo :global(.github-stars:hover) {
    background: var(--color-accent);
  }
  .hero-repo > span {
    color: var(--color-muted-foreground);
    font-size: 12px;
    line-height: 1.5;
  }
  .hero-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-top: 1px solid var(--color-border);
    padding-block: 20px;
    font-size: 12px;
    color: var(--color-muted-foreground);
  }
  .hero-bottom a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 12px;
    color: var(--color-foreground);
    text-decoration: none;
  }
  .levels {
    padding-block: 112px;
    scroll-margin-top: 24px;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 48px;
    margin-bottom: 48px;
  }
  .section-heading .eyebrow {
    margin-bottom: 24px;
  }
  .section-heading > p {
    max-width: 280px;
    color: var(--color-muted-foreground);
  }
  .evaluation-note {
    max-width: 740px;
    font-size: 14px;
    color: var(--color-muted-foreground);
    margin-block: 28px;
  }
  .checkpoint {
    padding-block: 72px;
  }
  .checkpoint-inner {
    display: flex;
    justify-content: space-between;
    gap: 48px;
    align-items: center;
  }
  .checkpoint h2 {
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1.1;
    color: var(--color-foreground);
    margin-top: 20px;
  }
  .checkpoint-inner > p {
    max-width: 400px;
    color: var(--color-muted-foreground);
  }
  .credits {
    padding-block: 48px 72px;
  }
  .credits > p + p {
    margin-top: 16px;
    max-width: 820px;
    font-size: 14px;
    color: var(--color-muted-foreground);
  }
  .credits a {
    color: var(--color-foreground);
  }
  @media (max-width: 1000px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .hero-copy {
      padding-top: 0;
    }
    .hero {
      padding-top: 40px;
    }
  }
  @media (max-width: 767px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 48px;
      padding-bottom: 32px;
    }
    .hero {
      padding-top: 32px;
    }
    h1 {
      font-size: clamp(3rem, 12vw, 5rem);
    }
    .hero-eyebrow {
      margin-bottom: 24px;
    }
    .hero-bottom > span {
      max-width: 160px;
    }
    .levels {
      padding-block: 64px;
    }
    .section-heading,
    .checkpoint-inner {
      flex-direction: column;
      gap: 24px;
      align-items: start;
    }
    .section-heading > p {
      max-width: 100%;
    }
    .section-heading {
      margin-bottom: 32px;
    }
    .checkpoint {
      padding-block: 48px;
    }
  }
</style>
