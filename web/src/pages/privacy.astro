---
import Section from '@/components/Section.astro';
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { site } from '@/data/site';
import { withBase } from '@/lib/paths';
---

<Layout
  title="Privacy notice"
  description="RAG-Ladder is a static site hosted on Cloudflare. It loads a GitHub star count, accepts no uploads and runs no advertising, analytics or session replay."
>
  <PageHeader
    eyebrow="LEGAL / PRIVACY"
    title="Privacy notice."
    description="RAG-Ladder is a static website. It does not ask for personal data and does not accept uploads."
  />
  <Section eyebrow="PRIVACY NOTICE" class="page-section prose">
    <p class="text-muted-foreground">Last updated: 18 November 2026</p>
    <h2>Hosting</h2>
    <p>
      The site is static and hosted on Cloudflare (Cloudflare Pages, served
      through a Cloudflare Worker). To deliver and protect the site, Cloudflare
      processes standard request data, such as your IP address and your
      browser’s user agent. See{' '}
      <a
        href="https://www.cloudflare.com/privacypolicy/"
        target="_blank"
        rel="noopener noreferrer"
        class="underline"
      >
        Cloudflare’s privacy policy
      </a>
      .
    </p>
    <h2>GitHub star count</h2>
    <p>
      The Star button shows how many people starred the project on GitHub. To
      get that number, your browser sends a request to GitHub’s API
      (api.github.com), so GitHub receives that request, including your IP
      address and user agent. No GitHub account or token is used. See{' '}
      <a
        href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
        target="_blank"
        rel="noopener noreferrer"
        class="underline"
      >
        GitHub’s privacy statement
      </a>
      .
    </p>
    <h2>The “Try it” demo</h2>
    <p>
      The demo is currently disabled. No files are uploaded, stored or sent to a
      model. Its fields only show a “Coming soon” message.
    </p>
    <h2>Cookies and storage</h2>
    <p>
      The site sets no cookies. It keeps one item in your browser’s
      localStorage: the cached star count. See{' '}
      <a href={withBase('/cookies/')} class="underline">
        cookies and browser storage
      </a>
      .
    </p>
    <h2>No tracking</h2>
    <p>The site uses no advertising, analytics or session replay.</p>
    <h2>Contact</h2>
    <p>
      Email{' '}
      <a href={`mailto:${site.contact}`} class="underline">
        {site.contact}
      </a>
      . For questions about the project, open an issue on{' '}
      <a
        href={site.issues}
        target="_blank"
        rel="noopener noreferrer"
        class="underline"
      >
        GitHub Issues
      </a>
      .
    </p>
  </Section>
</Layout>
