---
import Section from '@/components/Section.astro';
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { site } from '@/data/site';
import { withBase } from '@/lib/paths';
---

<Layout
  title="Cookies and browser storage"
  description="RAG-Ladder sets no cookies. It keeps one item in localStorage: a cached GitHub star count."
>
  <PageHeader
    eyebrow="LEGAL / COOKIES"
    title="No cookies. One stored item."
    description="Everything this site keeps in your browser is listed below."
  />
  <Section eyebrow="COOKIES AND STORAGE" class="page-section prose">
    <p class="text-muted-foreground">Last updated: 18 November 2026</p>
    <h2>Cookies</h2>
    <p>The site sets no cookies.</p>
    <h2>Browser storage</h2>
    <p>
      The site keeps one item in localStorage and nothing in sessionStorage. It
      works the same if you clear or block storage.
    </p>
    <ul>
      <li>
        <strong>Key:</strong> <code>rag-ladder:github-stars:v1</code>
      </li>
      <li>
        <strong>Purpose:</strong> the project’s public GitHub star count and
        when it was fetched, so the count is not requested on every page.
      </li>
      <li>
        <strong>Lifetime:</strong> reused for up to one hour, then refreshed.
        Kept until you clear site data.
      </li>
    </ul>
    <h2>No tracking</h2>
    <p>The site uses no advertising, analytics or session replay.</p>
    <h2>More</h2>
    <p>
      Read the{' '}
      <a href={withBase('/privacy/')} class="underline">
        privacy notice
      </a>
      . Questions:{' '}
      <a href={`mailto:${site.contact}`} class="underline">
        {site.contact}
      </a>{' '}
      or{' '}
      <a
        href={site.issues}
        target="_blank"
        rel="noopener noreferrer"
        class="underline"
      >
        GitHub Issues
      </a>
      .
    </p>
  </Section>
</Layout>
