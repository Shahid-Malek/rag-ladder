---
import { ClientRouter } from 'astro:transitions';
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import ErrorNotice from '@/components/ErrorNotice';
import { explain } from '@/lib/errors';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { withBase } from '@/lib/paths';
import '@/styles/global.css';
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
const socialImage = Astro.site
  ? new URL(withBase('/og-image.png'), Astro.site).href
  : withBase('/og-image.png');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <title>{title} · RAG-Ladder</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} · RAG-Ladder`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RAG-Ladder" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="RAG-Ladder. Same notes. Three ways to answer. Naive, Intermediate and Advanced."
    />
    <meta name="twitter:card" content="summary_large_image" />
    {canonical && !noindex && (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:url" content={canonical} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={withBase(interFont)}
      crossorigin="anonymous"
    />
    <script is:inline>
      if (!window.__ragPageErrors) {
        window.__ragPageErrors = true;
        const show = () => {
          const reveal = () => {
            const notice = document.getElementById('script-error');
            if (notice) notice.hidden = false;
          };
          if (document.readyState === 'loading')
            document.addEventListener('DOMContentLoaded', reveal, {
              once: true,
            });
          else reveal();
        };
        window.addEventListener(
          'error',
          (event) => {
            if (
              event.target instanceof HTMLScriptElement ||
              /chunk|module script|dynamically imported/i.test(
                event.message || '',
              )
            )
              show();
          },
          true,
        );
        window.addEventListener('unhandledrejection', (event) => {
          if (/chunk|module|dynamically imported/i.test(String(event.reason)))
            show();
        });
        window.addEventListener('vite:preloadError', show);
      }
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link pill" href="#main">
      Skip to content
    </a>
    <Header />
    <div class="container mt-4" id="script-error" hidden>
      <ErrorNotice error={explain(null, 'page')} />
    </div>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '@/scripts/site';
    </script>
  </body>
</html>
